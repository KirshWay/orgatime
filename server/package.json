{
  "name": "orgatime-server",
  "version": "1.0.3",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit --incremental false",
    "build": "nest build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "admin:reset-link": "node dist/scripts/admin-reset-link.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "10.1.8",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "archiver": "7.0.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/archiver": "7.0.0",
    "@types/node": "25.9.9",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express": "11.2.8",
      "@nestjs/platform-fastify>fastify": "$fastify",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "@nestjs/swagger>js-yaml": "5.4.1",
      "@nestjs/cli>webpack": "5.112.2",
      "@nestjs/cli>glob": "14.0.2",
      "archiver-utils>glob": "14.0.2",
      "glob@14.0.2>minimatch": "11.0.1",
      "@swc/cli>minimatch": "11.0.1",
      "readdir-glob>minimatch": "11.0.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
